<%- include('./partials/header') %>
<!-- videos.ejs -->
<div class="album py-5">
  <div class="container backgroundElements">
    <a href="/detalles/<%= videos.productId %>" class="btn btn-md btn-outline-secondary rounded-pill mt-3 mb-3 align-items-start"><i class="bi-svg bi-arrow-left fs-4 me-1"></i>Volver</a>
    <h2 class="mt-2 mb-4 text-center"><%= videos.title %></h2>
    <div class="d-flex flex-row justify-content-center align-items-center lead g-4">
      <h3 class="mb-4 me-3">Descripcion de:</h3>
      <p ><%= videos.productTitle %></p>
    </div>
    <p class="lead text-center"><%= videos.description%></p>
    

    <% if (videos && videos.videos.length > 0) { %>
      <div class="row justify-content-center g-4">
        <% videos.videos.forEach(video => { %>
          <div class="col-12 col-md-6 col-lg-4 d-flex flex-column align-items-center mb-3">
            <strong class="mb-2 text-center">Título: <%= video.name %></strong>
            <div class="ratio ratio-16x9 w-100" style="max-width: 480px;">
              <iframe 
                src="https://www.youtube.com/embed/<%= video.youTubeId || video.youtubeId %>"
                referrerpolicy="strict-origin-when-cross-origin" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
              </iframe>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="lead text-center mb-4">No hay videos disponibles.</p>
    <% } %>
  </div>
</div>
<%- include('./partials/footer') %>
