{
  "name": "hibrid-api-express-26",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "build": "npm run build:client && npm run build:server",
    "dev": "cross-env NODE_ENV=development concurrently \"vite\" \"tsx watch --tsconfig tsconfig.server.json server/index.ts\"",
    "build:client": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "preview": "cross-env NODE_ENV=development concurrently \"vite preview\" \"tsx watch --tsconfig tsconfig.server.json server/index.ts\"",
    "lint": "eslint . --fix",
    "test:unit": "cross-env NODE_ENV=test vitest run --project unit",
    "test:integration": "cross-env NODE_ENV=test vitest run --project integration",
    "test": "cross-env NODE_ENV=test vitest run"
  },
  "keywords": [],
  "author": "antorrg-software",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "ejs": "^7.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "firebase": "^13.1.0",
    "morgan": "^1.12.0",
    "multer": "^2.4.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.17.2",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "req-valid-express": "^1.1.3",
    "sequelize": "^6.37.8",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "5.0.3",
    "concurrently": "^10.0.6",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "^17.11.0",
    "jsdom": "^30.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "7.1.7",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.3"
  }
}